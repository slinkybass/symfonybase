{% if this.isBadge() %}
    {% if this.url %}
        <a
            class="badge bg-transparent gap-2 text-decoration-none"
            href="{{ this.url }}"
            {% if not this.showBadgeLabel %}
                title="{{ this.label|e('html_attr') }}"
                aria-label="{{ this.label|e('html_attr') }}"
                data-bs-toggle="tooltip"
                data-bs-placement="top"
            {% endif %}
        >
    {% else %}
        <span
            class="badge bg-transparent gap-2"
            {% if not this.showBadgeLabel %}
                title="{{ this.label|e('html_attr') }}"
                aria-label="{{ this.label|e('html_attr') }}"
                data-bs-toggle="tooltip"
                data-bs-placement="top"
            {% endif %}
        >
    {% endif %}
            <twig:UserAvatar :user="this.user" :size="this.avatarSize" />{% if this.showBadgeLabel %} {{ this.label }}{% endif %}
    {% if this.url %}
        </a>
    {% else %}
        </span>
    {% endif %}
{% elseif this.isCard() %}
    {% if this.url %}
        <a class="card card-sm card-link" href="{{ this.url }}">
    {% else %}
        <div class="card card-sm">
    {% endif %}
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <twig:UserAvatar :user="this.user" :size="this.avatarSize" />
                    </div>
                    <div class="col">
                        <div class="fw-medium text-truncate">{{ this.label }}</div>
                        {% if this.sublabel %}
                            <span class="badge badge-sm bg-muted-lt text-muted">{{ this.sublabel }}</span>
                        {% elseif this.user and this.user.role %}
                            <twig:Role :role="this.user.role" size="sm" />
                        {% endif %}
                    </div>
                </div>
            </div>
    {% if this.url %}
        </a>
    {% else %}
        </div>
    {% endif %}
{% endif %}
