{% set role_style = 'background-color: ' ~ this.backgroundColor ~ '; color: ' ~ this.foregroundColor %}
{% if this.url %}
    <a href="{{ this.url }}" class="{{ this.classes }} text-decoration-none" style="{{ role_style }}">{{ this.role }}</a>
{% else %}
    <span class="{{ this.classes }}" style="{{ role_style }}">{{ this.role }}</span>
{% endif %}