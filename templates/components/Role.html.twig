{% if this.url %}
    <a
        href="{{ this.url }}"
        class="{{ this.classes }} text-decoration-none"
        style="{{ this.inlineStyle|e('html_attr') }}"
    >
        {{ this.role }}
    </a>
{% else %}
    <span class="{{ this.classes }}" style="{{ this.inlineStyle|e('html_attr') }}">
        {{ this.role }}
    </span>
{% endif %}
