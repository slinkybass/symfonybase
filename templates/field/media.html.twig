{% if field.value %}
    {% set allowZoom = field.customOptions.get('allow_zoom')|default(false) %}
    {% set size = ea.crud.currentAction == 'detail' ? 'xl' : 'md' %}
    <twig:Media :src="field.value" :zoom="allowZoom" :size="size" />
{% else %}
    {{ include(ea.templatePath('label/empty')) }}
{% endif %}
