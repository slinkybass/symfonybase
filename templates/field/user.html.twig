{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}

{% set associationType = field.customOptions.get(constant('App\\Field\\UserField::OPTION_ASSOCIATION_TYPE')) %}
{% set isToMany = associationType == 'toMany' or field.value is iterable %}
{% set isIndex = ea.crud.currentAction == 'index' %}
{% set avatarSize = field.customOptions.get(constant('App\\Field\\UserField::OPTION_AVATAR_SIZE')) ?? constant('App\\Field\\UserField::DEFAULT_AVATAR_SIZE') %}
{% set stackedAvatarSize = field.customOptions.get(constant('App\\Field\\UserField::OPTION_STACKED_AVATAR_SIZE')) ?? constant('App\\Field\\UserField::DEFAULT_STACKED_AVATAR_SIZE') %}
{% set variantDetail = field.customOptions.get(constant('App\\Field\\UserField::OPTION_VARIANT_DETAIL')) ?? constant('App\\Field\\UserField::DEFAULT_VARIANT_DETAIL') %}
{% set sublabel = field.customOptions.get(constant('App\\Field\\UserField::OPTION_SUBLABEL')) ?? constant('App\\Field\\UserField::DEFAULT_SUBLABEL') %}

{% if field.value is not null and field.value is not empty and (not isToMany or field.value|length > 0) %}
    {% if isToMany %}
        {% if isIndex %}
            <div class="d-flex flex-fill flex-wrap">
                <div class="avatar-list avatar-list-stacked" data-bs-toggle="modal" data-bs-target="#info-{{ field.uniqueId }}" role="button">
                    {% set limit = 5 %}
                    {%- for user in field.value|slice(0, limit) -%}
                        <twig:UserAvatar :user="user" :size="stackedAvatarSize" />
                    {%- endfor -%}
                    {%- if field.value|length > limit -%}
                        <span class="avatar avatar-{{ stackedAvatarSize }}">+{{ field.value|length - limit }}</span>
                    {%- endif -%}
                </div>
            </div>
            <div class="modal modal-blur fade text-start" id="info-{{ field.uniqueId }}" tabindex="-1" aria-labelledby="info-{{ field.uniqueId }}Label" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-body">
                            <div class="row row-cards">
                                {% for user in field.value %}
                                    <div class="col-md-4">
                                        {{ _self.render_user(user, constant('App\\Twig\\Components\\User::VARIANT_CARD'), avatarSize, sublabel) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            {% if variantDetail == constant('App\\Twig\\Components\\User::VARIANT_BADGE') %}
                <div class="d-flex flex-wrap gap-2">
                    {% for user in field.value %}
                        {{ _self.render_user(user, variantDetail, avatarSize, sublabel) }}
                    {% endfor %}
                </div>
            {% else %}
                <div class="row row-cards">
                    {% for user in field.value %}
                        <div class="col-md-3">
                            {{ _self.render_user(user, variantDetail, avatarSize, sublabel) }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    {% else %}
        {{ _self.render_user(field.value, constant('App\\Twig\\Components\\User::VARIANT_BADGE'), avatarSize, sublabel) }}
    {% endif %}
{% else %}
    {{ include(ea.templatePath('label/empty')) }}
{% endif %}

{% macro render_user(user, variant = null, avatarSize = null, sublabel = null) %}
    {% if user is not null and user.id is defined and user.role is defined %}
        {% set crudControllerFqcn = user.role.isAdmin ? 'App\\Controller\\Admin\\Cruds\\AdminCrudController' : 'App\\Controller\\Admin\\Cruds\\UserCrudController' %}
        {% set controllerName = crudControllerFqcn|split('\\')|last|replace({'CrudController': ''}) %}
        {% set hasPermission = has_permission_crud_action(controllerName, 'detail') %}
        {% set url = hasPermission ? ea_url().setController(crudControllerFqcn).setAction('detail').setEntityId(user.id) : null %}
    {% else %}
        {% set url = null %}
    {% endif %}
    {% set variant = variant is not null ? variant : constant('App\\Field\\UserField::DEFAULT_VARIANT_DETAIL') %}
    {% set avatarSize = avatarSize is not null ? avatarSize : constant('App\\Field\\UserField::DEFAULT_AVATAR_SIZE') %}
    {% set sublabel = sublabel is not null ? sublabel : constant('App\\Field\\UserField::DEFAULT_SUBLABEL') %}
    <twig:User
        :user="user"
        :url="url"
        :variant="variant"
        :avatarSize="avatarSize"
        :sublabel="sublabel"
    />
{% endmacro %}
