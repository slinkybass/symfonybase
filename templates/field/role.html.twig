{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{# @var field \EasyCorp\Bundle\EasyAdminBundle\Dto\FieldDto #}
{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}

{% if field.value %}
    {% set roleCrudFqcn = 'App\\Controller\\Admin\\Cruds\\RoleCrudController' %}
    {% set controllerName = roleCrudFqcn|split('\\')|last|replace({'CrudController': ''}) %}
    {% set hasPermission = has_permission_crud_action(controllerName, 'detail') %}
    {% set url = hasPermission ? ea_url().setController(roleCrudFqcn).setAction('detail').setEntityId(field.value.id) : null %}
    <twig:Role
        :role="field.value"
        :url="url"
    />
{% else %}
    {{ include(ea.templatePath('label/empty')) }}
{% endif %}
