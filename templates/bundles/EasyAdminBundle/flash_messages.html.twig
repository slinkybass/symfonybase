{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Provider\AdminContext #}
{% trans_default_domain ea() ? ea().i18n.translationDomain : (translation_domain is defined ? translation_domain ?? 'messages') %}

{% set flash_messages = app.flashes %}

{% if flash_messages|length > 0 %}
    <script type="module">
        {% for label, messages in flash_messages %}
            {% for message in messages %}
                {# flash messages can be plain strings or arrays with 'message', 'title' and 'icon' keys #}
                {% if message is iterable %}
                    {% set flash_title = message.title is defined ? message.title|trans : null %}
                    {% set flash_message = (message.message ?? '')|trans %}
                    {% set icon = message.icon ?? null %}
                {% else %}
                    {% set flash_title = null %}
                    {% set flash_message = message|trans %}
                    {% set icon = null %}
                {% endif %}
                {% if icon is null %}
                    {% if label == 'success' or label == 'done' %}
                        {% set icon = 'success' %}
                    {% elseif label == 'info' %}
                        {% set icon = 'info' %}
                    {% elseif label == 'warning' or label == 'exception' %}
                        {% set icon = 'warning' %}
                    {% elseif label == 'danger' or label == 'error' %}
                        {% set icon = 'error' %}
                    {% else %}
                        {% set icon = 'info' %}
                    {% endif %}
                {% endif %}
                Swal.fire({
                    {% if flash_title %}title: '{{ flash_title|e('js') }}',{% endif %}
                    text: '{{ flash_message|e('js') }}',
                    icon: '{{ icon|e('js') }}',
                    showConfirmButton: false
                });
            {% endfor %}
        {% endfor %}
    </script>
{% endif %}
