{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{% extends '@!EasyAdmin/crud/form_theme.html.twig' %}

{# Skip EasyAdmin `data-ea-i18n-*` on TomSelect widgets; strings live in `assets/js/fields/i18n/tomselect.*.js`. #}
{% block choice_widget_collapsed %}
    {{ block('choice_widget_collapsed', '@EasyAdmin/symfony-form-themes/bootstrap_5_layout.html.twig') }}
{% endblock choice_widget_collapsed %}

{% block ea_form_fieldset_open_label %}
    {# don't use 'ea_help is not empty' here; it'll trigger deprecation messages: Method TranslatableMessage::__toString() is deprecated #}
    {% set has_help = ea_help is not same as(false) and ea_help is not null and ea_help is not same as('') %}
    {% set collapsed_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_COLLAPSED') %}
    {% set fieldset_error_count_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_FIELDSET_ERROR_COUNT') %}
    {% set fieldset_error_count = form.vars.ea_vars.field.getCustomOption(fieldset_error_count_option_name)|default(0) %}
    {% set is_collapsed = form.vars.ea_vars.field.getCustomOption(collapsed_option_name)|default(false) %}

    <div class="card-header {{ ea_is_collapsible ? 'collapsible' }}">
        <div class="card-title">
            {% if ea_is_collapsible %}
                <a href="#content-{{ form.vars.name }}" data-bs-toggle="collapse"
                   class="link-dark text-decoration-none {{ is_collapsed ? 'collapsed' }}"
                   aria-expanded="{{ is_collapsed ? 'false' : 'true' }}" aria-controls="content-{{ form.vars.name }}">
                    {{ ea_form_ealabel(form) }}
                    {%- if fieldset_error_count > 0 -%}
                        <span class="badge badge-danger" title="{{ 'form.tab.error_badge_title'|trans({'%count%': fieldset_error_count}, 'EasyAdminBundle') }}">
                            {{- fieldset_error_count -}}
                        </span>
                    {%- endif -%}
                </a>
            {% else %}
                {{ ea_form_ealabel(form) }}
                {%- if fieldset_error_count > 0 -%}
                    <span class="badge badge-danger" title="{{ 'form.tab.error_badge_title'|trans({'%count%': fieldset_error_count}, 'EasyAdminBundle') }}">
                        {{- fieldset_error_count -}}
                    </span>
                {%- endif -%}
            {% endif %}

            {% if has_help %}
                <span class="form-help ms-1" title="{{ ea_help|trans|raw }}" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true">?</span>
            {% endif %}
        </div>
    </div>
{% endblock ea_form_fieldset_open_label %}

{% block ea_form_fieldset_open_row %}
    {# don't use 'ea_help is not empty' here; it'll trigger deprecation messages: Method TranslatableMessage::__toString() is deprecated #}
    {% set has_help = ea_help is not same as(false) and ea_help is not null and ea_help is not same as('') %}
    {# don't use 'form.vars.label is not empty' here; it'll trigger deprecation messages: Method TranslatableMessage::__toString() is deprecated #}
    {% set has_label = form.vars.label is not same as(false) and form.vars.label is not null and form.vars.label is not same as('') %}
    {% set fieldset_has_header = has_label or ea_icon or has_help %}
    {% set collapsed_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_COLLAPSED') %}
    {% set fieldset_error_count_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_FIELDSET_ERROR_COUNT') %}
    {% set fieldset_has_errors = form.vars.ea_vars.field.getCustomOption(fieldset_error_count_option_name)|default(0) > 0 %}
    {% set is_collapsed = form.vars.ea_vars.field.getCustomOption(collapsed_option_name)|default(false) %}

    <div class="card mb-3 {{ ea_css_class }} {{ form.vars.attr.class|default('') }}" {% for key, value in form.vars.attr %}{% if key != 'class' %}{{ key }}="{{ value|e('html') }}" {% endif %}{% endfor %}>
        <div class="card-status-top bg-primary"></div>
        <fieldset>
            {% if fieldset_has_header %}
                {{ form_label(form) }}
            {% endif %}

            <div id="content-{{ form.vars.name }}" class="card-body {{ ea_is_collapsible ? 'collapse' }} {{ not is_collapsed ? 'show'}}">
                <div class="row">
{% endblock ea_form_fieldset_open_row %}

{% block ea_form_tablist_row %}
    {% set tab_id_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_TAB_ID') %}
    {% set tab_is_active_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_TAB_IS_ACTIVE') %}
    {% set tab_error_count_option_name = constant('EasyCorp\\Bundle\\EasyAdminBundle\\Field\\FormField::OPTION_TAB_ERROR_COUNT') %}
    {% set field = form.vars.ea_vars.field %}

    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                {% for tab in field.getCustomOption('tabs') %}
                    <li class="nav-item">
                        <a class="nav-link gap-1 {% if tab.getCustomOption(tab_is_active_option_name) %}active{% endif %}" href="#{{ tab.getCustomOption(tab_id_option_name) }}" id="tablist-{{ tab.getCustomOption(tab_id_option_name) }}" data-bs-toggle="tab">
                            {%- if tab.getCustomOption('icon')|default(false) -%}
                                <twig:ea:Icon name="{{ tab.getCustomOption('icon') }}" />
                            {%- endif -%}
                            {{ tab.label|trans(domain: ea().i18n.translationDomain)|raw }}

                            {% set tab_error_count = tab.getCustomOption(tab_error_count_option_name)  %}
                            {%- if tab_error_count > 0 -%}
                                <span class="badge bg-danger text-white ms-1" title="{{ 'form.tab.error_badge_title'|trans({'%count%': tab_error_count}, 'EasyAdminBundle') }}">
                                    {{- tab_error_count -}}
                                </span>
                            {%- endif -%}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
{% endblock ea_form_tablist_row %}

{% block ea_form_tabpane_group_open_row %}
    <div class="card-body">
        <div class="tab-content">
{% endblock ea_form_tabpane_group_open_row %}

{% block ea_form_tabpane_group_close_row %}
        </div>
    </div>
</div>
{% endblock ea_form_tabpane_group_close_row %}

{% block repeated_row %}
    {# Same as EasyAdmin, plus an inner .row so password/repeated children can split col-md-6. #}
    {% set field = form.vars.ea_vars.field|default(null) %}

    <div class="{{ field.columns ?? field.defaultColumns ?? '' }}">
        <div class="row">
            {{- block('form_rows') -}}
        </div>
    </div>

    {% if field.columns|default(null) is null %}
        <div class="flex-fill"></div>
    {% endif %}
{% endblock repeated_row %}

{% block form_row %}
    {% set row_attr = row_attr|merge({
        class: row_attr.class|default('') ~ ' form-group',
    }) %}
    {# 'field' is null for Symfony forms not created with EasyAdmin fields (e.g. FormGenerator). #}
    {% set parent_ea_field = form.parent.vars.ea_vars.field|default(null) %}
    {% set ea_field = form.vars.ea_vars.field|default(null) %}
    {% set isRepeated = parent_ea_field and parent_ea_field.formType == "Symfony\\Component\\Form\\Extension\\Core\\Type\\RepeatedType" %}
    {% set field = isRepeated ? parent_ea_field : ea_field %}
    {# Parent repeated_row already applies field.columns; children split that slot in half.
       FormGenerator passes columns via row_attr data-ea-columns. #}
    {% if isRepeated %}
        {% set column_class = 'col-md-6' %}
    {% elseif field is not null %}
        {% set column_class = field.columns ?? field.defaultColumns ?? '' %}
    {% else %}
        {% set column_class = row_attr['data-ea-columns']|default('') %}
    {% endif %}

    <div class="{{ column_class }}">
        {%- set row_class = row_class|default(row_attr.class|default('mb-3')) -%}
        <div {% with {attr: row_attr|merge({class: (row_class ~ ((not compound or force_error|default(false)) and not valid ? ' has-error'))|trim})} %}{{ block('attributes') }}{% endwith %}>
            {{- form_label(form) -}}
            <div class="form-widget mb-3">
                {# EasyAdmin API: ea_addons from prepend()/append() + money/percent symbols.
                   Tabler markup: Bootstrap input-group instead of ea-input-group. #}
                {% set ea_addons = ea_addons|default({prepend: [], append: []}) %}
                {% set has_addons = ea_addons.prepend is not empty or ea_addons.append is not empty %}
                {% set field_help = field.help ?? null %}
                {% set has_help = field_help ?? form.vars.help ?? false %}

                {% if has_help %}
                    <div class="row g-2">
                        <div class="col">
                {% endif %}

                {% if has_addons %}
                    <div class="input-group input-group-flat{{ disabled ? ' disabled' }}">
                        {% for addon in ea_addons.prepend %}
                            <span class="input-group-text">
                                {%- if addon.icon %}<twig:ea:Icon name="{{ addon.icon }}" />{% endif %}{% if addon.html %}{{ addon.html|trans|raw }}{% elseif addon.text %}{{ addon.text }}{% endif -%}
                            </span>
                        {% endfor %}
                        {{ form_widget(form) }}
                        {% for addon in ea_addons.append %}
                            <span class="input-group-text">
                                {%- if addon.icon %}<twig:ea:Icon name="{{ addon.icon }}" />{% endif %}{% if addon.html %}{{ addon.html|trans|raw }}{% elseif addon.text %}{{ addon.text }}{% endif -%}
                            </span>
                        {% endfor %}
                    </div>
                {% else %}
                    {{ form_widget(form) }}
                {% endif %}

                {% if has_help %}
                        </div>
                        <div class="col-auto align-self-center">
                            {% if field_help %}
                                {% set helpMsg = field_help|trans(label_translation_parameters, translation_domain) %}
                            {% else %}
                                {% set helpMsg = form.vars.help|trans(form.vars.help_translation_parameters, form.vars.translation_domain) %}
                            {% endif %}
                            <span class="form-help" title="{{ helpMsg|raw }}" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true">?</span>
                        </div>
                    </div>
                {% endif %}

                {{- form_errors(form) -}}
            </div>
        </div>
    </div>

    {# EasyAdmin: flex-fill when columns were not set explicitly. FormGenerator: when data-ea-columns is empty. #}
    {% if not isRepeated and (field is not null ? field.columns|default(null) is null : column_class is empty) %}
        <div class="flex-fill"></div>
    {% endif %}
{% endblock form_row %}
{% block form_label -%}
    {% if label is same as(false) -%}
        {# don't display anything, not even an empty <label> element; if you want to not display
           any label contents but keep the form layout, use an empty string as the field label #}
    {%- else -%}
        {%- if compound is defined and compound -%}
            {%- set element = 'legend' -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label')|trim}) -%}
        {%- else -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label')|trim}) -%}
            {%- set label_attr = label_attr|merge({for: id}) -%}
        {%- endif -%}
        {% if required -%}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' required')|trim}) %}
        {%- endif -%}
        {% if label is same as('') -%}
            {# don't process the label; this is used to not display any label content
               but render an empty <label> element keep the form layout #}
        {%- elseif label is null -%}
            {%- if label_format is not empty -%}
                {% set label = label_format|replace({
                    '%name%': name,
                    '%id%': id,
                }) %}
            {%- else -%}
                {% set label = name|humanize %}
            {%- endif -%}
        {%- endif -%}
        <{{ element|default('label') }}{% if label_attr %}{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}{% endif %}>
        {%- if translation_domain is same as(false) -%}
            {%- if label_html|default(false) is same as(false) -%}
                {{- label -}}
            {%- else -%}
                {{- label|raw -}}
            {%- endif -%}
        {%- else -%}
            {%- if label_html|default(false) is same as(false) -%}
                {{- label|trans(label_translation_parameters, translation_domain) -}}
            {%- else -%}
                {{- label|trans(label_translation_parameters, translation_domain)|raw -}}
            {%- endif -%}
        {%- endif -%}
        </{{ element|default('label') }}>
    {%- endif -%}
{%- endblock form_label %}

{% block ea_filters_widget %}
    {% set applied_filters = ea().request.query.all()['filters']|default([])|keys %}
    {% set hidden_filters = ea().request.query.all()['filters']|default([])['hidden_filters']|default([])|filter(filter => filter)|keys %}

    {% for field in form %}
        <div class="col-12">
            <div class="filter-field form-check px-3 {% if field.vars.name in hidden_filters %}d-none{% endif %}" data-filter-property="{{ field.vars.name }}">
                <div class="filter-heading" id="filter-heading-{{ loop.index }}">
                    <div class="form-switch">
                        <input id="filter-checkbox-{{ loop.index }}" type="checkbox" class="form-check-input filter-checkbox" {% if field.vars.name in applied_filters %}checked{% endif %}>
                        <button type="button" class="d-none" data-bs-toggle="collapse" href="#filter-content-{{ loop.index }}" aria-expanded="{{ field.vars.name in applied_filters ? 'true' : 'false' }}" aria-controls="filter-content-{{ loop.index }}"></button>
                        <label class="checkbox-switch form-check-label" for="filter-checkbox-{{ loop.index }}"
                            {% for name, value in field.vars.label_attr|default([]) %}{{ name }}="{{ value|e('html') }}" {% endfor %}>
                            {# don't use 'field.vars.label is not empty' here; it'll trigger deprecation messages: Method TranslatableMessage::__toString() is deprecated #}
                            {% set has_filter_label = field.vars.label is not same as(false) and field.vars.label is not null and field.vars.label is not same as('') %}
                            {% set filter_label = has_filter_label ? field.vars.label : field.vars.name|humanize %}
                            {{ filter_label|trans(domain: ea().i18n.translationDomain) }}
                        </label>
                    </div>
                </div>
                <div id="filter-content-{{ loop.index }}" class="filter-content collapse {% if field.vars.name in applied_filters %}show{% endif %}" aria-labelledby="filter-heading-{{ loop.index }}">
                    <div class="form-widget m-3">
                        {{ form_widget(field) }}
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock ea_filters_widget %}

{% block empty_collection %}
    <div class="collection-empty mb-3"></div>
{% endblock empty_collection %}

{% block collection_entry_row %}
    {% set is_array_field = 'EasyCorp\\Bundle\\EasyAdminBundle\\Field\\ArrayField' == form_parent(form).vars.ea_vars.field.fieldFqcn|default(false) %}
    {% set is_complex = form_parent(form).vars.ea_vars.field.customOptions.get('entryIsComplex') ?? false %}
    {% set to_string_method = form_parent(form).vars.ea_vars.field.customOptions.get('entryToStringMethod') ?? null %}
    {% set allows_deleting_items = form_parent(form).vars.allow_delete|default(false) %}
    {% set render_expanded = not form.vars.valid or form_parent(form).vars.ea_vars.field.customOptions.get('renderExpanded')|default(false) %}
    {% set delete_item_button %}
        <button type="button" class="btn btn-sm btn-outline-danger btn-icon m-2 ms-0 field-collection-delete-button" title="{{ 'action.remove_item'|trans({}, 'EasyAdminBundle') }}">
            <twig:ea:Icon name="trash" />
        </button>
    {% endset %}

    <div class="field-collection-item mb-3 {{ is_complex ? 'field-collection-item-complex' }} {{ not form.vars.valid ? 'is-invalid' }}">
        {% if is_array_field|default(false) %}
            {{ form_label(form) }}
            {{ form_widget(form) }}
            {% if allows_deleting_items and not disabled %}
                {{ delete_item_button }}
            {% endif %}
        {% else %}
            <div class="accordion-item">
                <div class="accordion-header">
                    <button class="accordion-button {{ render_expanded ? '' : 'collapsed' }}" type="button" data-bs-toggle="collapse" data-bs-target="#{{ id }}-contents">
                        <twig:ea:Icon name="chevron-right" />
                        {{ value|ea_as_string(to_string_method)|default('#' ~ form.vars.name) }}
                    </button>
                    {% if allows_deleting_items and not disabled %}
                        {{ delete_item_button }}
                    {% endif %}
                </div>
                <div id="{{ id }}-contents" class="accordion-collapse collapse {{ render_expanded ? 'show' }}">
                    <div class="accordion-body">
                        {# form_widget_compound adds .row for non-collection compounds so col-* line up #}
                        {{ form_widget(form) }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock collection_entry_row %}

{# EasyAdmin wraps compound widgets; Bootstrap cols need to be direct .row children.
   Collections keep EA's double wrapper (JS targets [data-empty-collection] inside).
   Nested FormTypes (e.g. DemoEntityType entries) use a single .form-widget-compound.row. #}
{% block form_widget_compound %}
    {% if 'collection' in block_prefixes %}
        <div class="form-widget-compound">
            {% set isEmptyCollection = value is null or (value is iterable and value is empty) %}
            {% if isEmptyCollection %}
                {{ block('empty_collection') }}
            {% endif %}
            {% if isEmptyCollection or form.vars.prototype is defined %}
                {% set attr = attr|merge({'data-empty-collection': block('empty_collection')}) %}
            {% endif %}
            <div {{ block('widget_container_attributes') }}>
                {{- block('form_rows') -}}
                {{- form_rest(form) -}}
            </div>
        </div>
    {% else %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' form-widget-compound row')|trim}) %}
        <div {{ block('widget_container_attributes') }}>
            {{- block('form_rows') -}}
            {{- form_rest(form) -}}
        </div>
    {% endif %}
{% endblock form_widget_compound %}

{% block ea_slug_widget %}
    {% set plugin_on = attr['data-slug-field']|default('true') not in ['false', '0', false] %}

    {% if not plugin_on %}
        {{ block('form_widget') }}
    {% else %}
        {% set attr = attr|merge({
            'data-slug-target': target|split('|')|map(name => form.parent.children[name].vars.id)|json_encode,
        }) %}
        {% if attr['data-slug-confirm-text'] is defined %}
            {% set attr = attr|merge({
                'data-slug-confirm-text': attr['data-slug-confirm-text']|trans
            }) %}
        {% endif %}

        {# form_row already wraps prepend()/append() in .input-group; don't nest another group. #}
        {% set ea_addons = ea_addons|default({prepend: [], append: []}) %}
        {% set is_inside_addon_group = ea_addons.prepend is not empty or ea_addons.append is not empty %}

        {% set slug_widget %}
            {{ block('form_widget') }}
            <button type="button" class="btn btn-icon" data-slug-lock
                    data-slug-icon-locked="{{ component('ea:Icon', {name: 'lock'})|e('html') }}"
                    data-slug-icon-unlocked="{{ component('ea:Icon', {name: 'lock-open'})|e('html') }}"
                    aria-pressed="true">
                <twig:ea:Icon name="lock" />
            </button>
        {% endset %}

        {% if is_inside_addon_group %}
            {{ slug_widget }}
        {% else %}
            <div class="input-group">{{ slug_widget }}</div>
        {% endif %}
    {% endif %}
{% endblock %}

{% block ea_fileupload_widget %}
    <div class="d-flex flex-sm-row align-items-center" data-file-field="true">
        {% block currentFiles %}
            {% if currentFiles %}
                <div class="img-preview text-center me-2">
                    {% for file in currentFiles %}
                        {% if download_path %}<a href="{{ asset(download_path ~ file.filename) }}" target="_blank" title="{{ file.filename }}">{% endif %}
                            <twig:ea:Icon name="file" class="m-0" />
                        {% if download_path %}</a>{% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endblock %}

        <div class="input-group">
            {% set title = '' %}
            {% if currentFiles %}
                {% for file in currentFiles %}
                    {% set title = title ~ file.filename ~ (not loop.last ? ', ' : '') %}
                {% endfor %}
            {% endif %}
            {{ form_widget(form.file, { attr: form.file.vars.attr|merge({ title: title }) }) }}

            {% if currentFiles and allow_delete %}
                <button type="button" class="btn btn-icon file-delete-btn">
                    <twig:ea:Icon name="trash" class="m-0" />
                </button>
            {% endif %}
        </div>
        {% if currentFiles and allow_delete %}
            <div class="d-none">
                {{ form_widget(form.delete) }}
            </div>
        {% endif %}
    </div>
    {{ form_errors(form.file) }}
{% endblock %}

{% block collection_widget %}
    {# the "is iterable" check is needed because if an object implements __toString() and
               returns an empty string, "is empty" returns true even if it's not a collection #}
    {% set isEmptyCollection = value is null or (value is iterable and value is empty) %}
    {% set is_array_field = 'EasyCorp\\Bundle\\EasyAdminBundle\\Field\\ArrayField' == form.vars.ea_vars.field.fieldFqcn|default(false) %}

    <div class="ea-form-collection-items">
        {% if isEmptyCollection %}
            {{ block('empty_collection') }}
        {% elseif is_array_field %}
            {{ block('form_widget') }}
        {% else %}
            <div class="accordion">
                {{ block('form_widget') }}
            </div>
        {% endif %}
    </div>

    {% if isEmptyCollection or form.vars.prototype is defined %}
        {% set attr = attr|merge({'data-empty-collection': block('empty_collection') }) %}
    {% endif %}

    {% if allow_add|default(false) and not disabled %}
        <button type="button" class="btn btn-secondary field-collection-add-button">
            <twig:ea:Icon name="plus" /> {{ 'action.add_new_item'|trans({}, 'EasyAdminBundle') }}
        </button>
    {% endif %}
{% endblock collection_widget %}

{# Currency/% symbols come from ea_addons in form_row (EasyAdmin). Keep Tabler input classes only. #}
{% block money_widget -%}
    {%- set type = type|default('number') -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' text-end pe-2 no-spinners')|trim}) -%}
    {{- block('form_widget_simple') -}}
{%- endblock money_widget %}

{% block percent_widget -%}
    {%- set type = type|default('number') -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' text-end pe-2 no-spinners')|trim}) -%}
    {{- block('form_widget_simple') -}}
{%- endblock percent_widget %}
{% block password_widget %}
    {% set plugin_on = attr['data-password-field']|default('true') not in ['false', '0', false] %}
    {% set render_switch = plugin_on and (attr['data-password-switch']|default('true') not in ['false', '0', false]) %}
    {% set render_generator = plugin_on and (attr['data-password-generator']|default('true') not in ['false', '0', false]) %}
    {% set is_repeated = form.vars.name == 'first' or form.vars.name == 'second' %}
    {% set group = is_repeated ? form.parent.vars.id : id %}

    {% if plugin_on %}
        {% set attr = attr|merge({ 'data-password-field': group }) %}
    {% endif %}

    {% if form.vars.name == 'second' or (not render_switch and not render_generator) %}
        {{ parent() }}
    {% else %}
        <div class="row g-2">
            <div class="col">
                <div class="input-group">
                    {{ parent() }}
                    {% if render_switch %}
                        <button type="button" class="btn btn-icon" data-password-toggle="{{ group }}">
                            <twig:ux:icon class="icon" name="tabler:eye" />
                            <twig:ux:icon class="icon d-none" name="tabler:eye-off" />
                        </button>
                    {% endif %}
                </div>
            </div>
            {% if form.vars.name == 'first' and render_generator %}
                <div class="col-auto">
                    <button type="button" class="btn btn-icon" data-password-generate="{{ group }}">
                        <twig:ux:icon class="icon" name="tabler:key" />
                    </button>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock password_widget %}

{% block textarea_widget %}
    {% set field = form.vars.ea_vars.field ?? form_parent(form).vars.ea_vars.field %}

    {% set resizeable = field ? field.customOptions.get('resizeable') ?? true : true %}

    {% if not resizeable %}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' no-resize')|trim}) %}
    {% endif %}

    {{ parent() }}
{% endblock textarea_widget %}

{% block color_widget %}
    {{ block('form_widget_simple') }}
{% endblock color_widget %}

{% block signature_widget %}
    {% set plugin_on = attr['data-signature-field']|default('true') not in ['false', '0', false] %}
    {% set show_input = attr['data-signature-show-input']|default('false') not in ['false', '0', false] %}
    {% set show_undo = plugin_on and (attr['data-signature-show-undo']|default('true') not in ['false', '0', false]) %}
    {% set show_clear = plugin_on and (attr['data-signature-show-clear']|default('true') not in ['false', '0', false]) %}

    {% if plugin_on %}
        <div class="signature-pad-wrapper">
            <canvas class="signature-pad"></canvas>
        </div>
    {% endif %}

    {% if plugin_on and not show_input %}
        {% set attr = attr|merge({ class: (attr.class|default('') ~ ' d-none')|trim }) %}
    {% endif %}
    {{ block('form_widget_simple') }}

    {% if show_undo or show_clear %}
        <div class="signature-pad-actions">
            {% if show_undo %}
                <button class="btn btn-icon btn-secondary" type="button" data-signature-undo>
                    <twig:ea:Icon name="arrow-back-up" />
                </button>
            {% endif %}
            {% if show_clear %}
                <button class="btn btn-icon btn-danger" type="button" data-signature-clear>
                    <twig:ea:Icon name="eraser" />
                </button>
            {% endif %}
        </div>
    {% endif %}
{% endblock signature_widget %}

{% block datemultiple_widget %}
    {{ block('form_widget_simple') }}
{% endblock datemultiple_widget %}

{%- block checkbox_widget -%}
    {%- set parent_label_class = parent_label_class|default(label_attr.class|default('')) -%}
    {%- if 'checkbox-switch' in parent_label_class -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-check-input')|trim}) -%}
        <div class="form-check form-switch">
            {{- form_label(form, null, {widget: block('checkbox_switch_input')}) -}}
        </div>
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock checkbox_widget %}

{%- block checkbox_switch_input -%}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
{%- endblock checkbox_switch_input %}

