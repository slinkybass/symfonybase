<div {{ attributes.defaults({class: 'd-flex align-items-center w-100'}) }}>
    {% if this.showResultsCount and this.numResults is not null %}
        <div class="text-muted">
            {{ 'paginator.results'|trans({'%count%': this.numResults|format}, this.translationDomain)|raw }}
        </div>
    {% endif %}

    {% set has_previous_page = this.hasPreviousPage %}
    {% set has_next_page = this.hasNextPage %}
    {% if has_previous_page or has_next_page %}
        {% set current_page = this.getCurrentPage %}
        {% set is_rtl = this.isRtl %}
        <ul class="pagination m-0 ms-auto">
            <li class="page-item {{ not has_previous_page ? 'disabled' }}">
                <a class="page-link" href="{{ not has_previous_page ? '#' : this.urlForPage(this.previousPage) }}">
                    <twig:ea:Icon name="{{ is_rtl ? 'chevron-right' : 'chevron-left' }}" />
                </a>
            </li>

            {% if this.showPageNumbers %}
                {% for page in this.pageRange %}
                    <li class="page-item {{ page == current_page ? 'active' }} {{ page is null ? 'disabled' }}">
                        {% if page is null %}
                            <span class="page-link">&hellip;</span>
                        {% else %}
                            <a class="page-link" href="{{ this.urlForPage(page) }}">{{ page }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            {% else %}
                <li class="page-item active">
                    <a class="page-link" href="{{ this.urlForPage(current_page) }}">{{ current_page }}</a>
                </li>
            {% endif %}

            <li class="page-item {{ not has_next_page ? 'disabled' }}">
                <a class="page-link" href="{{ not has_next_page ? '#' : this.urlForPage(this.nextPage) }}">
                    <twig:ea:Icon name="{{ is_rtl ? 'chevron-left' : 'chevron-right' }}" />
                </a>
            </li>
        </ul>
    {% endif %}
</div>
