{% set flash_messages = app.flashes %}

{% if flash_messages|length > 0 %}
    <script type="module">
        {% set flash_icons = {
            success: 'success',
            done: 'success',
            info: 'info',
            warning: 'warning',
            exception: 'warning',
            danger: 'error',
            error: 'error',
        } %}
        {% for label, messages in flash_messages %}
            {% for message in messages %}
                {% set icon = flash_icons[label]|default('info') %}
                Swal.fire({
                    html: '{{ message|raw }}',
                    icon: '{{ icon }}',
                    showConfirmButton: false
                });
            {% endfor %}
        {% endfor %}
    </script>
{% endif %}
